# Read by compose.yaml only (substitution). Copy to .env to override.
# Every value is optional; the defaults below are used when a variable is unset.
# Apps and packages keep their own .env (e.g. packages/database/.env.example).
# If you change the role passwords here, change them in those DB URLs too.

POSTGRES_PASSWORD="postgres"
LEDGER_MIGRATOR_PASSWORD="password"
LEDGER_RUNTIME_PASSWORD="password"
LEDGER_DB_PORT=5432
